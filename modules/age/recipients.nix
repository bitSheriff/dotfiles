{
  config, # Top-level NixOS config
  pkgs,
  inputs,
  lib,
  activeUsers,
  ...
}:
{

  ##################
  ## HOME MANAGER ##
  ##################
  home-manager.users.benjamin =
    lib.mkIf (lib.elem "benjamin" activeUsers && config.cfg.socials.irc.enable)
      (
        { config, osConfig, ... }: {

          # Public Keys / Recipients
          home.file.".age/recipients/llk.pub".text =
            "";

          home.file.".age/recipients/hosts/rhodos.pub".text =
            "";

          home.file.".age/recipients/hosts/delos.pub".text =
            "";
        }
      );
}
